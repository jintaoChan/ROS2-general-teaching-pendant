      <geometry>
        <mesh
          filename="package://fake_ur_config/meshes/link0.STL" />
      </geometry>
    </collision> -->
  </link>
  <joint
    name="joint0"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="-3.1416 0 0" />
    <parent
      link="base_link" />
    <child
      link="link0" />
    <axis
      xyz="0 0 -1" />
    <limit
      lower="${-2*pi}"
      upper="${2*pi}"
      effort="1000"
      velocity="${pi/4}" />
  </joint>
  <link
