<?xml version="1.0" encoding="utf-8"?>
<robot name="fake_ur" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="fake_ur">
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-1.32903356359508E-12 -5.95336903906293E-12 0.0338776670857649"
        rpy="0 0 0" />
      <mass
        value="1.44940327015999" />
      <inertia
        ixx="0.00492881883825976"
        ixy="8.32451425175137E-10"
        ixz="-2.25385858188084E-13"
        iyy="0.00492878171505367"
        iyz="-2.84223274357211E-13"
        izz="0.00951858321864677" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fake_ur_config/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <!-- <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fake_ur_config/meshes/base_link.STL" />
      </geometry>
    </collision> -->
  </link>
  <link
    name="link0">
    <inertial>
      <origin
        xyz="0.03008 -0.00078887 -0.15015"
        rpy="0 0 0" />
      <mass
        value="0.55122" />
      <inertia
        ixx="0.0014776"
        ixy="-1.0447E-05"
        ixz="2.7138E-05"
        iyy="0.0014029"
        iyz="-2.7658E-06"
